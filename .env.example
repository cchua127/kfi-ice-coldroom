# ---------------------------------------------------------------------------
# Local development: these defaults work as-is with `docker compose up`.
# ---------------------------------------------------------------------------
POSTGRES_USER=kfi
POSTGRES_PASSWORD=kfi_dev_password
POSTGRES_DB=kfi_ice
POSTGRES_PORT=5432
DATABASE_URL=postgresql://kfi:kfi_dev_password@localhost:5432/kfi_ice

# Session signing key. Generate with: openssl rand -base64 32
AUTH_SECRET=REPLACE_ME_dev_only

# Set to false on any real deployment: the seed then creates no development
# logins at all, rather than creating them for you to remember to remove.
SEED_DEV_USERS=true

# Where uploaded TNB bill PDFs and supplier DOs are written. The DB stores the
# path; the original file is kept forever.
UPLOAD_DIR=./data/uploads

# Store timestamptz, display Asia/Kuala_Lumpur. Business dates are `date`.
TZ=UTC
DISPLAY_TZ=Asia/Kuala_Lumpur

# ---------------------------------------------------------------------------
# TNB bill parsing. Without a key the upload still works and the review form
# opens empty for manual keying — parsing is an accelerator, never a gate.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
BILL_PARSER_MODEL=claude-sonnet-5

# ---------------------------------------------------------------------------
# Droplet only. Fill on the host before the first `docker compose up`.
# ---------------------------------------------------------------------------
SITE_DOMAIN=REPLACE_ME.example.com
ACME_EMAIL=REPLACE_ME@example.com

# Nightly pg_dump + uploads tarball, 30-day retention. See README runbook.
SPACES_ENDPOINT=REPLACE_ME
SPACES_REGION=REPLACE_ME
SPACES_BUCKET=REPLACE_ME
SPACES_ACCESS_KEY=REPLACE_ME
SPACES_SECRET_KEY=REPLACE_ME
BACKUP_RETENTION_DAYS=30
